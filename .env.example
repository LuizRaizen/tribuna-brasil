# Copie para .env e ajuste. Nunca versione o .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-longo
# HMAC que identifica a mesma pessoa entre fontes (a partir do CPF publicado pelo TSE). Mantenha estável.
IDENTITY_HASH_KEY=troque-por-outro-valor-aleatorio-longo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=tribuna
POSTGRES_USER=tribuna
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://tribuna:troque-esta-senha@postgres:5432/tribuna

REDIS_URL=redis://redis:6379/0

# URL pública do frontend (usada nos links de e-mail)
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Dev: Mailpit (http://localhost:8025). Prod: smtp+tls://usuario:senha@host:587
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Tribuna Brasil <nao-responda@tribuna.local>

# Quantos proxies reversos confiáveis ficam à frente do backend (Caddy = 1)
TRUSTED_PROXY_COUNT=0

# Fonte oficial de resultados (não altere em produção)
TSE_RESULTS_BASE_URL=https://resultados.tse.jus.br/oficial
# Barramento do tempo real: "redis" (padrão). "memory" só para um único processo sem Redis.
RESULTS_BUS=redis
# Modo leve sem Redis para desenvolvimento local: descomente as duas linhas
# CACHE_BACKEND=locmem
# RESULTS_BUS=memory

# Chave pública do DataJud (CNJ). Opcional: o padrão é a chave vigente publicada na wiki da API;
# defina só se o CNJ trocá-la (https://datajud-wiki.cnj.jus.br/api-publica/acesso).
# DATAJUD_API_KEY=
