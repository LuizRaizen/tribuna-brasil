# Ponto de entrada público: frontend estático e proxy para a API, na mesma origem
# (cookies SameSite + CSRF funcionam sem abrir CORS).
#
# Dois modos, escolhidos por SITE_ADDRESS no .env:
#   - "tribuna.duckdns.org" (ou outro domínio): o Caddy emite o certificado TLS (Let's Encrypt).
#   - ":80" atrás do Cloudflare Tunnel: o TLS termina no Cloudflare e o Caddy fica só na rede interna.
{
	email {$ACME_EMAIL}
	servers {
		# Confia nos cabeçalhos X-Forwarded-* apenas quando vêm da rede interna dos contêineres
		# (cloudflared). Requisições da internet não conseguem forjar IP ou esquema.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	@backend path /api/* /admin* /static/* /accounts/* /health /ready
	handle @backend {
		# O Caddy repassa X-Forwarded-For/Proto/Host automaticamente, respeitando trusted_proxies.
		# O SSE (text/event-stream) é transmitido sem buffer.
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

		# Arquivos com hash no nome são imutáveis; o shell e o service worker nunca são cacheados.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
