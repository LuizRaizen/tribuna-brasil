# Produção. Copie para /opt/tribuna/.env na VM e preencha. Nunca versione o .env.
# Gere segredos com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Endereço público ---------------------------------------------------------
# Opção gratuita: subdomínio DuckDNS apontando para o IP da VM (o Caddy emite o TLS).
SITE_ADDRESS=tribuna.duckdns.org
ACME_EMAIL=seu-email@exemplo.com
# Opção com domínio próprio + Cloudflare Tunnel: SITE_ADDRESS=":80", TRUSTED_PROXY_COUNT=2
# e o token do túnel abaixo.
# CLOUDFLARE_TUNNEL_TOKEN=
TRUSTED_PROXY_COUNT=1

# --- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Chave do HMAC que identifica a mesma pessoa entre fontes (a partir do CPF publicado pelo TSE).
# Gere uma vez e NUNCA troque: trocar desfaz a ligação entre registros já importados.
IDENTITY_HASH_KEY=troque-por-outro-valor-aleatorio-longo
DJANGO_ALLOWED_HOSTS=tribuna.duckdns.org
DJANGO_ADMIN_URL=painel-troque-este-caminho/
FRONTEND_URL=https://tribuna.duckdns.org
CSRF_TRUSTED_ORIGINS=https://tribuna.duckdns.org
API_DOCS_ENABLED=false

# --- Banco e cache ------------------------------------------------------------
POSTGRES_DB=tribuna
POSTGRES_USER=tribuna
POSTGRES_PASSWORD=troque-esta-senha-longa
DATABASE_URL=postgres://tribuna:troque-esta-senha-longa@postgres:5432/tribuna
REDIS_URL=redis://redis:6379/0

# --- E-mail (confirmação de conta e redefinição de senha) ----------------------
# Ex.: Brevo (gratuito, 300 e-mails/dia): smtp+tls://LOGIN:CHAVE_SMTP@smtp-relay.brevo.com:587
# O "@" do login do Brevo (xxx@smtp-brevo.com) vira %40 dentro da URL. O remetente abaixo
# precisa estar verificado no Brevo. Teste com: manage.py enviar_email_teste seu@email.com
EMAIL_URL=smtp+tls://usuario:senha@smtp-relay.brevo.com:587
DEFAULT_FROM_EMAIL=Tribuna Brasil <seu-remetente-verificado@exemplo.com>

# --- Backups externos (opcional, requer rclone configurado na VM) ---------------
# BACKUP_RCLONE_REMOTE=oci:tribuna-backups

# Chave pública do DataJud (CNJ). Opcional: o padrão é a chave vigente publicada na wiki da API;
# defina só se o CNJ trocá-la (https://datajud-wiki.cnj.jus.br/api-publica/acesso).
# DATAJUD_API_KEY=
